// ระบบออมทรัพย์โรงเรียนบ้านกะดาด — Prisma schema
// หลักการสำคัญ: ธุรกรรมห้ามลบ (immutable) — ยกเลิกได้ด้วยการตั้ง status = VOIDED เท่านั้น
// ยอดคงเหลือ (Account.balance) ต้องตรวจสอบย้อนหลังได้จากผลรวม Transaction ที่ status = NORMAL
//
// รอบขยายฟีเจอร์ (2569-07): เพิ่ม EXECUTIVE, SchoolSetting, Guardian (แทน User.linkedStudentId),
// AuditLog, CashClosing, LineLinkCode, Transaction.category, User.lineUserId/mustChangePassword,
// Student.photoFileName — ดูรายละเอียดใน CONTRACTS.md หัวข้อ "รอบขยายฟีเจอร์"

generator client {
  provider        = "prisma-client-js"
  // driverAdapters + serverExternalPackages (ใน next.config) → OpenNext patch client ให้รันบน
  // Cloudflare Workers ได้ (ใช้ @prisma/adapter-pg ต่อ Postgres ผ่าน TCP — ไม่ติด wasm/fs)
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  PARENT
  EXECUTIVE // ผู้บริหาร (read-only) — เพิ่มรอบขยายฟีเจอร์
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  MOVED
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
}

enum TransactionStatus {
  NORMAL
  VOIDED
}

// ประเภทธุรกรรม: ปกติ (ฝาก-ถอนทั่วไป) หรือ ดอกเบี้ยรายปี
enum TransactionCategory {
  REGULAR
  INTEREST
}

model User {
  id           String  @id @default(cuid())
  username     String  @unique
  passwordHash String
  role         Role
  name         String

  // LINE integration (ฟีเจอร์แจ้งเตือน) — lineUserId ผูก 1 บัญชี LINE ต่อ 1 ผู้ใช้
  lineUserId String? @unique
  // บังคับเปลี่ยนรหัสผ่านครั้งถัดไปที่ล็อกอิน (เช่น หลังแอดมินรีเซ็ตรหัส)
  mustChangePassword Boolean @default(false)

  // ครูประจำชั้น (Classroom.teacherId)
  homeroomClassrooms Classroom[] @relation("HomeroomTeacher")

  recordedTransactions Transaction[] @relation("RecordedBy")
  voidedTransactions   Transaction[] @relation("VoidedBy")

  // ผู้ปกครอง -> นักเรียน (many-to-many ผ่าน Guardian) แทน linkedStudentId เดิม
  guardians Guardian[]

  // ปิดยอดเงินสดที่ผู้ใช้คนนี้เป็นผู้ปิด
  cashClosings CashClosing[] @relation("CashClosedBy")

  // โค้ดผูกบัญชี LINE ที่ออกให้ผู้ใช้คนนี้
  lineLinkCodes LineLinkCode[] @relation("LineLinkCodes")

  createdAt DateTime @default(now())
}

// ตั้งค่าโรงเรียน — แถวเดียว (singleton, id = 1) แทนชื่อโรงเรียนที่ hardcode
model SchoolSetting {
  id           Int      @id @default(1)
  schoolName   String
  schoolArea   String
  logoFileName String?
  updatedAt    DateTime @updatedAt
}

/// ไฟล์อัปโหลด (โลโก้โรงเรียน, รูปนักเรียน) เก็บเป็น bytes ใน DB แทนการเขียนลงดิสก์
/// เพื่อรองรับ serverless (Vercel/Cloudflare) ที่ไม่มีดิสก์ถาวร
/// pointer เดิมไม่เปลี่ยน: SchoolSetting.logoFileName / Student.photoFileName = UploadedFile.fileName
model UploadedFile {
  fileName    String   @id
  subdir      String
  contentType String
  data        Bytes
  size        Int
  createdAt   DateTime @default(now())

  @@index([subdir])
}

// ผู้ปกครอง <-> นักเรียน (1 ผู้ปกครองผูกได้หลายลูก) — แทน User.linkedStudentId เดิม
model Guardian {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, studentId])
  @@index([studentId])
}

// บันทึกการกระทำสำคัญ (audit trail) — userId เป็น String? (cuid ของ User) ไม่มี FK
// เพื่อให้ log อยู่รอดแม้ผู้ใช้ถูกลบ และ logAudit เป็น fire-and-forget
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// ปิดยอดเงินสดรายวัน — scope = "ALL" (ทั้งโรงเรียน) หรือ classroomId (รายห้อง)
model CashClosing {
  id            String   @id @default(cuid())
  closeDate     DateTime
  scope         String
  expectedNet   Decimal  @db.Decimal(12, 2)
  countedAmount Decimal  @db.Decimal(12, 2)
  note          String?
  closedById    String
  closedBy      User     @relation("CashClosedBy", fields: [closedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([closeDate, scope])
}

// โค้ดชั่วคราวสำหรับผูกบัญชี LINE เข้ากับผู้ใช้
model LineLinkCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  user      User      @relation("LineLinkCodes", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
}

model AcademicYear {
  id       String    @id @default(cuid())
  year     Int       @unique // ปี พ.ศ. เช่น 2569
  isActive Boolean   @default(false)
  openedAt DateTime  @default(now())
  closedAt DateTime?

  classrooms Classroom[]
  accounts   Account[]
}

model Classroom {
  id             String       @id @default(cuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String // เช่น "ป.1/1"
  teacherId      String?
  teacher        User?        @relation("HomeroomTeacher", fields: [teacherId], references: [id])

  students Student[]

  @@unique([academicYearId, name])
  @@index([teacherId])
}

model Student {
  id          String        @id @default(cuid())
  studentCode String        @unique // รหัสนักเรียน เช่น "69001"
  firstName   String
  lastName    String
  classroomId String
  classroom   Classroom     @relation(fields: [classroomId], references: [id])
  status      StudentStatus @default(ACTIVE)
  // ชื่อไฟล์รูปนักเรียน (เก็บใน UPLOADS_DIR/students) — null = ยังไม่มีรูป
  photoFileName String?

  accounts  Account[]
  guardians Guardian[]

  @@index([classroomId])
}

model Account {
  id             String       @id @default(cuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  // ยอดยกมาจากปีการศึกษาก่อนหน้า
  openingBalance Decimal      @default(0) @db.Decimal(12, 2)
  // ยอดคงเหลือปัจจุบัน (denormalized) = openingBalance + SUM(DEPOSIT) - SUM(WITHDRAW) เฉพาะ status NORMAL
  balance        Decimal      @default(0) @db.Decimal(12, 2)

  transactions Transaction[]

  @@unique([studentId, academicYearId])
  @@index([academicYearId])
}

model Transaction {
  id        String              @id @default(cuid())
  accountId String
  account   Account             @relation(fields: [accountId], references: [id])
  type      TransactionType
  // ประเภท: REGULAR (ฝาก-ถอนปกติ) หรือ INTEREST (ดอกเบี้ยรายปีที่ระบบจ่าย)
  category  TransactionCategory @default(REGULAR)
  amount    Decimal             @db.Decimal(12, 2) // ต้อง > 0 เสมอ (ตรวจฝั่งแอป)
  txnDate   DateTime // วันที่ทำรายการจริง (ครูอาจบันทึกย้อนหลัง)

  recordedById String
  recordedBy   User   @relation("RecordedBy", fields: [recordedById], references: [id])
  note         String?

  // ห้ามลบธุรกรรม — ยกเลิกด้วยการตั้ง VOIDED พร้อมระบุผู้ยกเลิกและเวลา
  status     TransactionStatus @default(NORMAL)
  voidedById String?
  voidedBy   User?             @relation("VoidedBy", fields: [voidedById], references: [id])
  voidedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([accountId, txnDate])
  @@index([txnDate])
  @@index([recordedById])
  @@index([status])
}
