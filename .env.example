# ===== ระบบออมทรัพย์โรงเรียนบ้านกะดาด =====
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามเครื่องจริง

# PostgreSQL connection string (Prisma)
DATABASE_URL=postgresql://savings:savings_dev_pw@localhost:5432/school_savings

# Secret สำหรับเซ็น JWT session cookie (production ต้องสุ่มใหม่ ยาว >= 32 ตัวอักษร)
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# รหัสผ่าน DB (ใช้กับ docker-compose / สคริปต์ตั้งค่า)
DB_PASSWORD=savings_dev_pw

# ติด Secure attribute ให้ session cookie หรือไม่ (true/false)
# ค่าเริ่มต้น false — deploy ปกติเข้าผ่าน http://<ip>:3000 ใน LAN ถ้าตั้ง true
# browser จะทิ้ง cookie แล้ว login ไม่ติด
# ตั้ง true "เฉพาะ" เมื่อมี HTTPS reverse proxy ข้างหน้า และผู้ใช้เข้าผ่าน https เท่านั้น
COOKIE_SECURE=false
